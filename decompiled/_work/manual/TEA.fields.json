   "note": "the calibration matrix"
  },
  "0x2e00": {
   "name": "lengthTables",
   "type": "void*[101]",
   "note": "per-length tables loaded on demand"
  },
  "0x2f94": {
   "name": "path",
   "type": "std::string",
   "note": "the .tsd path"
  },
  "0x2f9c": {
   "name": "pathData",
   "type": "char*",
   "note": "character data of path"
  }
 },
 "MatchEngineSet": {
