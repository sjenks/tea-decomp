{
 "Pattern": {
  "0x0": {
   "name": "count",
   "type": "int",
   "note": "number of pooled strings"
  },
  "0x8": {
   "name": "pool",
   "type": "std::string[256]",
   "note": "the pooled sub-patterns and choice-list letter sets (16 bytes each)"
  }
 },
 "MatchEngine": {
  "0x1008": {
   "name": "bc",
   "type": "std::string",
   "note": "compiled bytecode of the leaf"
  },
  "0x1010": {
   "name": "bcData",
   "type": "char*",
   "note": "character data of bc"
  },
  "0x1018": {
   "name": "minLen",
   "type": "int",
   "note": "fewest letters a match can have"
  },
  "0x101c": {
   "name": "maxLen",
   "type": "int",
   "note": "most letters a match can have (above 100: unlimited)"
  },
  "0x1020": {
   "name": "valid",
   "type": "int",
   "note": "the pattern compiled"
  },
  "0x1024": {
   "name": "status",
   "type": "char",
   "note": "pattern error code (0 = none)"
  },
  "0x1025": {
   "name": "punctMode",
   "type": "char[256]",
   "note": "per byte: 0 ignore, 0xff significant punctuation, 0xfe case-exact letter"
  },
  "0x1128": {
   "name": "needsRaw",
   "type": "int",
   "note": "the pattern looks at punctuation or exact case"
  },
  "0x112c": {
   "name": "dictList",
   "type": "TSDictionaryList*",
   "note": "dictionaries the leaf was compiled for"
  },
  "0x1130": {
   "name": "dictIndex",
   "type": "int",
   "note": "which dictionary of the list"
  },
  "0x1134": {
   "name": "shortest",
   "type": "int",
   "note": "shortest-word setting"
  },
  "0x1138": {
   "name": "longest",
   "type": "int",
   "note": "longest-word setting"
  },
  "0x113c": {
   "name": "curLen",
   "type": "int",
   "note": "length of the words being tested"
  },
  "0x1140": {
   "name": "slack",
   "type": "int",
   "note": "curLen - minLen"
  },
  "0x1144": {
   "name": "lastOp",
   "type": "char",
   "note": "last opcode emitted while compiling"
  },
  "0x1148": {
   "name": "opCount",
   "type": "int",
   "note": "opcodes emitted while compiling"
  },
  "0x114c": {
   "name": "matcher",
   "type": "code*",
   "note": "matcher chosen by Compile (MatchGeneral or a fast path)"
  }
 },
 "InputEngine": {
  "0x0": {
   "name": "next",
   "type": "InputEngine*",
   "note": "next engine in the global list"
  },
  "0x4": {
   "name": "prev",
   "type": "InputEngine*",
   "note": "previous engine in the global list"
  },
  "0x8": {
   "name": "dictList",
   "type": "TSDictionaryList*",
   "note": "dictionary list"
  },
  "0xc": {
   "name": "dictIndex",
   "type": "int",
   "note": "dictionary within the list"
  },
  "0x10": {
   "name": "dict",
   "type": "Dictionary*",
   "note": "the dictionary being read"
  },
  "0x14": {
   "name": "hFile",
   "type": "HANDLE",
   "note": "the open .tsd file (INVALID_HANDLE_VALUE when closed)"
  },
  "0x18": {
   "name": "fileOffset",
   "type": "uint",
   "note": "file position to resume reading at"
  },
  "0x1c": {
   "name": "wordsScanned",
   "type": "int",
   "note": "words decoded so far"
  },
  "0x20": {
   "name": "letters",
   "type": "byte[]",
   "note": "the current word's letter classes (0xff-terminated), followed by punctuation and filtered copies"
  },
  "0x408": {
   "name": "rawWord",
   "type": "char[]",
   "note": "the current word as stored, then its annotation"
