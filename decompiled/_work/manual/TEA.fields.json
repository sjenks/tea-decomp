   "note": "letter classes used"
  },
  "0x2bf6": {
   "name": "numTotalLetters",
   "type": "short",
   "note": "letter classes in the alphabet"
  },
  "0x2bf8": {
   "name": "canonical",
   "type": "char[256]",
   "note": "letter class -> display byte"
  },
  "0x2cf8": {
   "name": "symbolByte",
