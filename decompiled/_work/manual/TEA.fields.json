  "0x2404": {
   "name": "defPass2",
   "type": "uint",
   "note": "start of headword definitions"
  },
  "0x2408": {
   "name": "defEnd",
   "type": "uint",
   "note": "definition section end"
  },
  "0x240c": {
   "name": "numLengths",
   "type": "ushort",
   "note": "longest word length + 1"
  },
  "0x2410": {
   "name": "wordStreamOffset",
   "type": "uint[101]",
   "note": "file offset of each length's word stream"
  },
  "0x25a4": {
   "name": "wordCount",
   "type": "uint[101]",
   "note": "words of each length"
