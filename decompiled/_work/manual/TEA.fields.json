  "0x4": {
   "name": "enginesBegin",
   "type": "MatchEngine**",
   "note": "engines begin"
  },
  "0x8": {
   "name": "enginesEnd",
   "type": "MatchEngine**",
   "note": "engines end"
  },
  "0x18": {
   "name": "enginesCapacityEnd",
   "type": "MatchEngine**",
   "note": "engines end of storage"
  },
  "0x20": {
