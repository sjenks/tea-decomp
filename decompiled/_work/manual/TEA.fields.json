  "0x7f0": {
   "name": "readBuf",
   "type": "byte[0x4000]",
   "note": "file read buffer"
  },
  "0x47f0": {
   "name": "bitPtr",
   "type": "uint*",
   "note": "next 32-bit word of the bit stream"
