  }
 },
 "Common": {
  "0x0": {
   "name": "path",
   "type": "std::string",
   "note": "path of common.ini"
  },
  "0x8": {
   "name": "pathData",
   "type": "char*",
   "note": "character data of path"
  }
 }
}
