  "0x47f4": {
   "name": "bitEnd",
   "type": "uint*",
   "note": "end of the buffered bit stream"
  },
  "0x47f8": {
   "name": "bitPos",
   "type": "int",
   "note": "bits already used of the current word"
  },
  "0x47fc": {
   "name": "length",
   "type": "int",
   "note": "word length being read"
  },
  "0x4800": {
   "name": "linkMode",
   "type": "char",
   "note": "TSD1 link bits: 2 while reading words with link flags"
  },
  "0x4804": {
   "name": "hasLinks",
   "type": "int",
   "note": "the current word has definitions or an occurrence list"
  },
  "0x4808": {
   "name": "linkIndex",
   "type": "int",
   "note": "1-based count of linked words so far"
  }
 },
 "TSDictionaryList": {
  "0x0": {
   "name": "paths",
   "type": "char*",
   "note": "the ';'-separated path list"
  },
  "0x8": {
   "name": "dicts",
   "type": "std::vector",
   "note": "the dictionaries (Dictionary pointers)"
  },
  "0xc": {
   "name": "dictsBegin",
   "type": "Dictionary**",
   "note": "dicts begin"
  },
  "0x10": {
   "name": "dictsEnd",
   "type": "Dictionary**",
   "note": "dicts end"
  },
  "0x20": {
   "name": "dictsCapacityEnd",
   "type": "Dictionary**",
   "note": "dicts end of storage"
  }
 },
 "TSDictionaryList::Dictionary": {
  "0x4": {
   "name": "huffman",
   "type": "int[768][2]",
