  "0x1804": {
   "name": "lookahead8",
   "type": "int[256]",
   "note": "node or symbol reached after 8 bits"
  },
  "0x1c04": {
   "name": "lookahead8Len",
   "type": "int[256]",
   "note": "code length of that symbol"
  },
  "0x2004": {
   "name": "loaded",
   "type": "int",
   "note": "the header loaded"
  },
  "0x2008": {
   "name": "fileTime",
   "type": "FILETIME",
   "note": "last-write time when loaded"
  },
  "0x2010": {
   "name": "refCount",
   "type": "int",
   "note": "lists sharing this dictionary"
  },
  "0x2014": {
   "name": "description",
   "type": "char[1000]",
   "note": "header description"
  },
  "0x23fc": {
   "name": "format",
   "type": "int",
   "note": "0 = TSD0, 1 = TSD1"
