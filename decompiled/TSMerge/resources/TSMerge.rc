    CONTROL "Cha&nge...",112, "BUTTON", 0x50030000, 310, 80, 51, 12
    CONTROL "Secondary Input List:",-1, "STATIC", 0x50000000, 4, 104, 119, 8
    CONTROL "",102, "EDIT", 0x50830880, 123, 102, 187, 12
