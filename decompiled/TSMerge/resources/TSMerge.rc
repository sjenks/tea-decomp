    CONTROL "To ASCII",117, "BUTTON", 0x50000009, 188, 22, 170, 12
    CONTROL "To ASCII letters",118, "BUTTON", 0x50000009, 188, 34, 170, 12
    CONTROL "To ASCII lower case letters",119, "BUTTON", 0x50000009, 188, 46, 170, 12
    CONTROL "To ASCII upper case letters",121, "BUTTON", 0x50000009, 188, 58, 170, 12
    CONTROL "Primary Input List:",-1, "STATIC", 0x50000000, 4, 82, 119, 8
