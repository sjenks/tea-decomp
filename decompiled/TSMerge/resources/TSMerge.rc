    CONTROL "",258, "BUTTON", 0x5002000b, 5, 146, 355, 29
    CONTROL "S&tart",101, "BUTTON", 0x58030001, 6, 182, 77, 20
    CONTROL "&Help...",106, "BUTTON", 0x50010000, 97, 182, 78, 20
