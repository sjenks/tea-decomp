// Resources decoded from TEACON.exe (static parse of the PE .rsrc section; not the original .rc source)
// Compiles with a resource compiler (checked with GNU windres). Bitmaps, icons and cursors are listed at the end, not included.
#include <windows.h>

1 VERSIONINFO
FILEVERSION 2,11,0,0
PRODUCTVERSION 2,11,0,0
FILEFLAGSMASK 0x0000003fL
FILEFLAGS 0x00000000L
FILEOS 0x00000004L
FILETYPE 0x00000001L
FILESUBTYPE 0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "Crossword Man"
            VALUE "FileDescription", "TEA Crossword Helper console version"
            VALUE "FileVersion", "2.11.0.0"
            VALUE "InternalName", "TEA"
            VALUE "LegalCopyright", "Copyright © 2011 Crossword Man. All Rights Reserved."
            VALUE "LegalTrademarks", ""
            VALUE "OriginalFilename", "Teacon.exe"
            VALUE "ProductName", "TEA Crossword Helper"
            VALUE "ProductVersion", "2.11"
            VALUE "Comments", "Production Build"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END

