IDD_LOOKUP_METHODS DIALOGEX 139, 100, 380, 285
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Lookup Methods"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Test word:", -1, 8, 9, 44, 8
    EDITTEXT IDC_LM_TEST_WORD, 52, 7, 268, 12, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Test &lookup", IDC_LM_TEST, 320, 7, 52, 12, WS_TABSTOP
    GROUPBOX "Use &web search script:", -1, 8, 21, 364, 75
    AUTO3STATE "Name:", 13200, 12, 32, 40, 12, WS_TABSTOP
    EDITTEXT 13210, 52, 32, 64, 12, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Address:", -1, 127, 34, 32, 8
    EDITTEXT 13220, 160, 32, 208, 12, ES_AUTOHSCROLL | WS_TABSTOP
