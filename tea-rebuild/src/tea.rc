// The definition window's client: a tree of dictionaries and definitions, and the definition text.
IDD_DEFINITION_VIEW DIALOGEX 0, 0, 308, 168
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_DEF_TREE, "SysTreeView32", TVS_HASBUTTONS | TVS_SHOWSELALWAYS | TVS_DISABLEDRAGDROP | WS_BORDER | WS_TABSTOP, 4, 4, 100, 160
    CONTROL "", IDC_DEF_TEXT, "RICHEDIT50W", ES_MULTILINE | ES_READONLY | ES_NOHIDESEL | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 108, 4, 196, 160
END

