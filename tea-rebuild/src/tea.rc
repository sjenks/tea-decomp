// Resources for tea.exe. Dialog layouts and identifiers follow the original TEA.exe so that the two
// programs look alike and the same test script can drive both.
#include <windows.h>
#include <commctrl.h>
#include <richedit.h>
#include "resource.h"

1 RT_MANIFEST "tea.manifest"
IDI_TEA ICON "tea.ico"

IDM_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O", CM_FILE_OPEN
        MENUITEM "&Close *", CM_FILE_CLOSE
        MENUITEM "Save Results from * &As...\tCtrl+S", CM_SAVE_RESULTS
        MENUITEM SEPARATOR
        MENUITEM "&Demote *", CM_DEMOTE
        MENUITEM "Pro&mote *", CM_PROMOTE
        MENUITEM SEPARATOR
        MENUITEM "P&roperties from *", CM_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "&Print Results from *...\tCtrl+P", CM_PRINT
        MENUITEM "Print Pre&view Results from *...", CM_PRINT_PREVIEW
        MENUITEM "Page Set&up...", CM_PAGE_SETUP
        MENUITEM SEPARATOR
        MENUITEM "", CM_MRU_FIRST
        MENUITEM SEPARATOR
        MENUITEM "E&xit", CM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Cu&t\tCtrl+X", CM_CUT
        MENUITEM "&Copy\tCtrl+C", CM_COPY
        MENUITEM "&Paste\tCtrl+V", CM_PASTE
        MENUITEM SEPARATOR
        MENUITEM "&Select All\tCtrl+A", CM_SELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "&Lookup...\tCtrl+Enter", CM_LOOKUP
        MENUITEM "Lookup in &New Window...\tShift+Ctrl+Enter", CM_LOOKUP_NEW
        POPUP "&External Lookup"
        BEGIN
            MENUITEM SEPARATOR
            MENUITEM "&Setup...", CM_EXTERNAL_SETUP
        END
    END
    POPUP "T&ools"
    BEGIN
        MENUITEM "&Dictionary Builder", CM_DICTIONARY_BUILDER
        MENUITEM "&Word List Merge", CM_WORD_LIST_MERGE
        MENUITEM SEPARATOR
        MENUITEM "&Options...", CM_OPTIONS
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "Always On &Top", CM_TOPMOST
        MENUITEM SEPARATOR
        MENUITEM "Tile &Horizontal", CM_TILE_HORIZONTAL
        MENUITEM "Tile &Vertical", CM_TILE_VERTICAL
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Quick Reference...", CM_QUICK_REFERENCE
        MENUITEM "&Startup Tips...", CM_STARTUP_TIPS
        MENUITEM "&Contents", CM_HELP_CONTENTS
        MENUITEM SEPARATOR
        MENUITEM "&About TEA...", CM_ABOUT
    END
END

IDM_DICTIONARY_CONTEXT MENU
BEGIN
    MENUITEM "P&roperties", CM_PROPERTIES
    MENUITEM SEPARATOR
    MENUITEM "&Close", CM_FILE_CLOSE
    MENUITEM "Save Results &As...\tCtrl+S", CM_SAVE_RESULTS
    MENUITEM SEPARATOR
    MENUITEM "&Demote", CM_DEMOTE
    MENUITEM "Pro&mote", CM_PROMOTE
END

IDM_RESULT_CONTEXT MENU
BEGIN
    MENUITEM "&Lookup...\tCtrl+Enter", CM_LOOKUP
    MENUITEM "Lookup in &New Window...\tShift+Ctrl+Enter", CM_LOOKUP_NEW
    POPUP "&External Lookup"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "&Setup...", CM_EXTERNAL_SETUP
    END
    MENUITEM SEPARATOR
    MENUITEM "&Copy\tCtrl+C", CM_COPY
    MENUITEM "&Select All\tCtrl+A", CM_SELECT_ALL
    MENUITEM SEPARATOR
    MENUITEM "&Print...\tCtrl+P", CM_PRINT
    MENUITEM "Print Pre&view...", CM_PRINT_PREVIEW
END

IDM_SEARCH_CONTEXT MENU
BEGIN
    MENUITEM "&Word Search\tCtrl+W", CM_WORD_SEARCH
    MENUITEM "&Full Text Search\tCtrl+F", CM_FULL_TEXT_SEARCH
END

IDM_DEFINITION_CONTEXT MENU
BEGIN
    POPUP "&Go To"
    BEGIN
        MENUITEM "&Previous Definition\tShift+Ctrl+Tab", CM_PREV_DEFINITION
        MENUITEM "&Next Definition\tCtrl+Tab", CM_NEXT_DEFINITION
        MENUITEM SEPARATOR
        MENUITEM "&Previous Result\tAlt+Up Arrow", CM_PREV_RESULT
        MENUITEM "&Next Result\tAlt+Down Arrow", CM_NEXT_RESULT
        MENUITEM SEPARATOR
        MENUITEM "&Back\tAlt+Left Arrow", CM_BACK
        MENUITEM "&Forward\tAlt+Right Arrow", CM_FORWARD
        MENUITEM SEPARATOR
    END
    MENUITEM SEPARATOR
    MENUITEM "&Lookup *\tCtrl+Enter", CM_LOOKUP
    MENUITEM "Lookup * in &New Window...\tShift+Ctrl+Enter", CM_LOOKUP_NEW
    POPUP "&External Lookup"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "&Setup...", CM_EXTERNAL_SETUP
    END
    MENUITEM SEPARATOR
    MENUITEM "&Copy\tCtrl+C", CM_COPY
    MENUITEM "&Select All\tCtrl+A", CM_SELECT_ALL
END

IDA_MAIN ACCELERATORS
BEGIN
    "^S", CM_SAVE_RESULTS
    VK_RETURN, CM_LOOKUP, VIRTKEY, CONTROL
    VK_RETURN, CM_LOOKUP_NEW, VIRTKEY, CONTROL, SHIFT
    VK_RETURN, CM_EXTERNAL_DEFAULT, VIRTKEY, CONTROL, ALT
    "^C", CM_COPY
    "^A", CM_SELECT_ALL
    "^P", CM_PRINT
    "^O", CM_FILE_OPEN
    "^W", CM_WORD_SEARCH
    "^F", CM_FULL_TEXT_SEARCH
    "1", 16010, VIRTKEY, ALT
    "2", 16011, VIRTKEY, ALT
    "3", 16012, VIRTKEY, ALT
    "4", 16013, VIRTKEY, ALT
    "5", 16014, VIRTKEY, ALT
    "6", 16015, VIRTKEY, ALT
    "7", 16016, VIRTKEY, ALT
    "8", 16017, VIRTKEY, ALT
    "9", 16018, VIRTKEY, ALT
    "0", 16019, VIRTKEY, ALT
END

IDA_DEFINITION ACCELERATORS
BEGIN
    VK_RETURN, CM_LOOKUP, VIRTKEY, CONTROL
    VK_RETURN, CM_LOOKUP_NEW, VIRTKEY, CONTROL, SHIFT
    VK_RETURN, CM_EXTERNAL_DEFAULT, VIRTKEY, CONTROL, ALT
    VK_LEFT, CM_BACK, VIRTKEY, ALT
    VK_RIGHT, CM_FORWARD, VIRTKEY, ALT
    VK_UP, CM_PREV_RESULT, VIRTKEY, ALT
    VK_DOWN, CM_NEXT_RESULT, VIRTKEY, ALT
    VK_TAB, CM_PREV_DEFINITION, VIRTKEY, CONTROL, SHIFT
    VK_TAB, CM_NEXT_DEFINITION, VIRTKEY, CONTROL
    "^C", CM_COPY
    "^A", CM_SELECT_ALL
END

// The pattern box, ruler and lists live in this child dialog, which the main window resizes.
IDD_PATTERN DIALOGEX 0, 0, 166, 323
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "P&attern", IDC_PATTERN_GROUP, 1, 0, 164, 64, WS_GROUP
    COMBOBOX IDC_PATTERN, 5, 10, 88, 300, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    DEFPUSHBUTTON "Word &Search", IDC_SEARCH, 93, 10, 60, 16, WS_TABSTOP | WS_GROUP | WS_DISABLED
    CONTROL "", IDC_SEARCH_MENU, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 153, 10, 8, 16
    LTEXT "Sho&rtest:", IDC_SHORTEST_LABEL, 5, 30, 34, 10
    EDITTEXT IDC_SHORTEST, 39, 29, 32, 12, ES_NUMBER | WS_TABSTOP | WS_GROUP
    CONTROL "", IDC_SHORTEST_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 63, 29, 8, 12
    LTEXT "&Longest:", IDC_LONGEST_LABEL, 99, 30, 30, 10
    EDITTEXT IDC_LONGEST, 129, 29, 32, 12, ES_NUMBER | WS_TABSTOP | WS_GROUP
    CONTROL "", IDC_LONGEST_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 153, 29, 8, 12
    LTEXT "", IDC_PROGRESS, 5, 44, 156, 16
END

IDD_OPTIONS DIALOGEX 43, 148, 276, 226
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "TEA Options"
FONT 8, "MS Shell Dlg"
BEGIN
    // Pattern
    LTEXT "&@ becomes:", IDC_OPT_AT_LABEL, 13, 27, 45, 8
    EDITTEXT IDC_OPT_AT, 58, 24, 100, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "&# becomes:", IDC_OPT_HASH_LABEL, 13, 46, 45, 8
    EDITTEXT IDC_OPT_HASH, 58, 43, 100, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "E&xclusive letter variables", IDC_OPT_EXCLUSIVE, 13, 65, 238, 9, WS_TABSTOP
    AUTOCHECKBOX "Ignore &unused punctuation", IDC_OPT_IGNORE_UNUSED, 13, 80, 238, 9, WS_TABSTOP
    // Result
    AUTOCHECKBOX "Sho&w dictionary annotations", IDC_OPT_ANNOTATIONS, 13, 24, 114, 9, WS_TABSTOP
    AUTOCHECKBOX "Show anagra&m balances", IDC_OPT_BALANCES, 13, 40, 114, 9, WS_TABSTOP
    GROUPBOX "Filtering", IDC_OPT_FILTER_GROUP, 13, 54, 250, 68
    AUTOCHECKBOX "Show words containing only &lower case letters (e.g. tail)", IDC_OPT_SHOW_LOWER, 19, 66, 242, 9, WS_TABSTOP
    AUTOCHECKBOX "Show words containing some &upper case letters (e.g. Charlie)", IDC_OPT_SHOW_UPPER, 19, 80, 242, 9, WS_TABSTOP
    AUTOCHECKBOX "Show words containing punc&tuation (e.g. tail-end)", IDC_OPT_SHOW_PUNCT, 19, 94, 242, 9, WS_TABSTOP
    AUTOCHECKBOX "Show phr&ases (e.g. tail-end Charlie)", IDC_OPT_SHOW_PHRASES, 19, 108, 242, 9, WS_TABSTOP
    GROUPBOX "&Double-click action", IDC_OPT_DBLCLICK_GROUP, 13, 128, 250, 40
    AUTORADIOBUTTON "Lookup", IDC_OPT_DBLCLICK_LOOKUP, 19, 140, 242, 9, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "External lookup", IDC_OPT_DBLCLICK_EXTERN, 19, 154, 242, 9
    // Sorting
    GROUPBOX "Sorting", IDC_OPT_SORT_GROUP, 13, 24, 250, 28
    AUTOCHECKBOX "S&ort alphabetically", IDC_OPT_SORT_ALPHA, 19, 37, 114, 9, WS_TABSTOP | WS_GROUP
    AUTOCHECKBOX "Ascending", IDC_OPT_SORT_ASCENDING, 145, 37, 114, 9, WS_TABSTOP
    GROUPBOX "Length grouping", IDC_OPT_LENGTH_GROUP, 13, 57, 250, 55
    AUTOCHECKBOX "Group &by length", IDC_OPT_GROUP_BY_LENGTH, 19, 69, 114, 9, WS_TABSTOP
    AUTORADIOBUTTON "Ascending", IDC_OPT_LENGTH_ASC, 145, 69, 114, 9, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Smart", IDC_OPT_LENGTH_SMART, 145, 83, 114, 9
    AUTORADIOBUTTON "Descending", IDC_OPT_LENGTH_DESC, 145, 97, 114, 9
    // Dictionary
    GROUPBOX "Multiple dictionar&y searching", IDC_OPT_MULTI_GROUP, 13, 24, 250, 52, WS_GROUP
    AUTORADIOBUTTON "Search all dictionaries independently", IDC_OPT_MULTI_INDEPENDENT, 18, 34, 243, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Search all dictionaries and suppress duplicated results", IDC_OPT_MULTI_SUPPRESS, 18, 48, 243, 12
    AUTORADIOBUTTON "Search active dictionary only", IDC_OPT_MULTI_ACTIVE, 18, 62, 243, 12
    GROUPBOX "Definition dictionaries", IDC_OPT_DEFDICT_GROUP, 13, 82, 250, 28
    COMBOBOX IDC_OPT_DEFDICTS, 18, 92, 196, 80, CBS_DROPDOWNLIST | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    PUSHBUTTON "Chan&ge...", IDC_OPT_DEFDICTS_CHANGE, 214, 92, 44, 12, WS_TABSTOP
    // Appearance
    GROUPBOX "Main window", IDC_OPT_MAIN_GROUP, 10, 24, 174, 84
    LTEXT "&Pattern font:", IDC_OPT_PATTERN_FONT_L, 16, 38, 97, 8
    CONTROL "", IDC_OPT_PATTERN_FONT, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 113, 35, 66, 14
    LTEXT "&Results font:", IDC_OPT_RESULT_FONT_L, 16, 56, 97, 8
    CONTROL "", IDC_OPT_RESULT_FONT, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 113, 53, 66, 14
    LTEXT "R&esults annotation font:", IDC_OPT_ANNOT_FONT_L, 16, 74, 97, 8
    CONTROL "", IDC_OPT_ANNOT_FONT, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 113, 71, 66, 14
    LTEXT "Pri&ntout font:", IDC_OPT_PRINT_FONT_L, 16, 92, 97, 8
    CONTROL "", IDC_OPT_PRINT_FONT, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 113, 89, 66, 14
    GROUPBOX "Definition windows", IDC_OPT_DEF_GROUP, 10, 115, 174, 66
    LTEXT "Bac&kground color:", IDC_OPT_DEF_BG_L, 15, 129, 97, 8
    CONTROL "", IDC_OPT_DEF_BG, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 112, 126, 66, 14
    LTEXT "De&fault font:", IDC_OPT_DEF_FONT_L, 15, 147, 97, 8
    CONTROL "", IDC_OPT_DEF_FONT, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 112, 144, 66, 14
    LTEXT "H&ighlight font:", IDC_OPT_DEF_HIGHLIGHT_L, 15, 165, 97, 8
    CONTROL "", IDC_OPT_DEF_HIGHLIGHT, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 112, 162, 66, 14
    // Common
    PUSHBUTTON "&Save as defaults", IDC_SAVE_DEFAULTS, 4, 208, 80, 14, WS_TABSTOP
    PUSHBUTTON "&Close", IDCANCEL, 171, 208, 48, 14, WS_TABSTOP
    PUSHBUTTON "&Help", IDC_HELP_BUTTON, 223, 208, 48, 14, WS_TABSTOP
    CONTROL "", IDC_OPT_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 4, 4, 268, 200
END

