    CTEXT "An independent reimplementation of TEA Crossword Helper 2.11", -1, 8, 42, 208, 8
    CTEXT "by Ross Beresford (Crossword Man)", -1, 8, 52, 208, 8
    CTEXT "", 11160, 8, 66, 208, 24
    CTEXT "Help, tips and the dictionaries are the original release's files.", -1, 8, 92, 208, 8
    DEFPUSHBUTTON "OK", IDOK, 88, 108, 48, 14
END

