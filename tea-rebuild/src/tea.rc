1 VERSIONINFO
FILEVERSION 2,11,0,1
PRODUCTVERSION 2,11,0,1
FILEOS 0x4L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "TEA Crossword Helper (rebuilt)"
            VALUE "FileVersion", "2.11.0.1"
            VALUE "InternalName", "tea"
            VALUE "OriginalFilename", "tea.exe"
            VALUE "ProductName", "TEA Crossword Helper (rebuilt)"
            VALUE "ProductVersion", "2.11"
            VALUE "Comments", "Independent reimplementation of TEA Crossword Helper 2.11"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
